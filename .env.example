# Studio models. Keys are read by the backend only.
# An explicit provider takes priority. With this blank, PARATERA_API_KEY selects
# Paratera, otherwise StepFun is used. Blank keys allow local editing and export.
POSTERLAB_PROVIDER=
PARATERA_API_KEY=
PARATERA_BASE_URL=https://llmapi.paratera.com/v1
# Each stage can use a different model deployment.
PARATERA_CHAT_MODEL=DeepSeek-V4-Pro-0813
PARATERA_PAPER_MODEL=Kimi-K3.1-Pro
PARATERA_CAMPAIGN_MODEL=DeepSeek-V4-Pro-0813
PARATERA_DESIGN_MODEL=DeepSeek-V4-Pro-0813
# This deployment must accept image_url input for rendered-image critique.
PARATERA_VISION_MODEL=Qwen3.7-Plus
# Separate, on-demand text-free hero image for an activity.
PARATERA_IMAGE_MODEL=Doubao-Seedream-4.5

# Optional: text assistance. Never put this key in frontend/VITE variables.
STEP_API_KEY=
# Lifetime local budget in CNY; unknown requests keep their reservations.
STUDIO_BUDGET_CNY=5
STUDIO_DATA_DIR=studio-data
POSTERLAB_PORT=8787

# Legacy research providers (optional)
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
# Model used for rendered-image critique
STEP_VISION_MODEL=step-5-preview
# High-effort, image-aware original design
STEP_DESIGN_MODEL=step-5-preview
STEP_DESIGN_EFFORT=high
