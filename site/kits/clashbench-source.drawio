<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" compressed="false"><diagram id="poster" name="小红书 · 一句提醒，拦不住智能体抢占资源"><mxGraphModel grid="0" guides="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1440" background="#fbfbf8"><root><mxCell id="0"/><mxCell id="layer-0" value="底色" parent="0"/><UserObject id="element-0" label="" name="纸面底色"><mxCell vertex="1" parent="layer-0" style="shape=rectangle;rounded=0;fillColor=#fbfbf8;strokeColor=none;strokeWidth=1;"><mxGeometry x="0" y="0" width="1080" height="1440" as="geometry"/></mxCell></UserObject><UserObject id="element-1" label="" name="刊头底色"><mxCell vertex="1" parent="layer-0" style="shape=rectangle;rounded=0;fillColor=#162c37;strokeColor=none;strokeWidth=1;"><mxGeometry x="0" y="0" width="1080" height="263.52" as="geometry"/></mxCell></UserObject><UserObject id="element-2" label="" name="主题色线"><mxCell vertex="1" parent="layer-0" style="shape=rectangle;rounded=0;fillColor=#754270;strokeColor=none;strokeWidth=1;"><mxGeometry x="0" y="0" width="1080" height="10.08" as="geometry"/></mxCell></UserObject><mxCell id="layer-3" value="海报内容" parent="0"/><UserObject id="element-3" label="" name="AI 概念配图 · Doubao-Seedream-4.5"><mxCell vertex="1" parent="layer-3" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/webp,;"><mxGeometry x="810.36" y="20.16" width="204.48" height="204.48" as="geometry"/></mxCell></UserObject><UserObject id="element-4" label="&lt;div style=&quot;line-height:1.22&quot;&gt;AI 概念配图&lt;/div&gt;" name="概念配图署名"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=14.04;fontColor=#c4d1d5;fontStyle=0;"><mxGeometry x="778.68" y="228.96" width="259.2" height="28.8" as="geometry"/></mxCell></UserObject><UserObject id="element-5" label="&lt;div style=&quot;line-height:1.22&quot;&gt;ClashBench：智能体破坏性资源抢&lt;br&gt;占风险评测&lt;/div&gt;" name="海报标题"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=43.578;fontColor=#fcfcf6;fontStyle=1;"><mxGeometry x="56.16" y="46.08" width="691.2" height="113.76" as="geometry"/></mxCell></UserObject><UserObject id="element-6" label="&lt;div style=&quot;line-height:1.22&quot;&gt;默认评测中，44.5%的有效运行让新任务完成、旧任务未通&lt;br&gt;过健康检查&lt;/div&gt;" name="宣传导语"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=25.92;fontColor=#c1d3da;fontStyle=0;"><mxGeometry x="58.32" y="169.92" width="691.2" height="74.88" as="geometry"/></mxCell></UserObject><UserObject id="element-7" label="&lt;div style=&quot;line-height:1.22&quot;&gt;冲突为何演变为&lt;br&gt;破坏&lt;/div&gt;" name="问题标题"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=23.76;fontColor=#754270;fontStyle=1;"><mxGeometry x="58.32" y="289.44" width="183.6" height="64.8" as="geometry"/></mxCell></UserObject><UserObject id="element-8" label="&lt;div style=&quot;line-height:1.22&quot;&gt;共享环境中，智能体可能为完成新任务而终止、覆盖或降级既有任务，&lt;br&gt;而非报告冲突；我们系统测量这一破坏性资源抢占风险。&lt;/div&gt;" name="研究问题"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=24.84;fontColor=#202e36;fontStyle=0;"><mxGeometry x="248.4" y="289.44" width="772.2" height="77.76" as="geometry"/></mxCell></UserObject><UserObject id="element-9" label="&lt;div style=&quot;line-height:1.22&quot;&gt;保护提示未能消除&lt;br&gt;抢占&lt;/div&gt;" name="结果标题"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=34.56;fontColor=#754270;fontStyle=1;"><mxGeometry x="58.32" y="416.16" width="284.04" height="89.28" as="geometry"/></mxCell></UserObject><UserObject id="element-10" label="&lt;div style=&quot;line-height:1.22&quot;&gt;默认条件下，DIR为&lt;br&gt;57.1%、SPR为44.5%；加&lt;br&gt;入保护既有任务的提示&lt;br&gt;后，二者仍达49.9%和&lt;br&gt;38.2%，未能消除抢占。&lt;/div&gt;" name="结果说明"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=23.76;fontColor=#202e36;fontStyle=0;"><mxGeometry x="58.32" y="521.28" width="284.04" height="298.397" as="geometry"/></mxCell></UserObject><UserObject id="element-11" label="" name="Table 1 · 原论文第 7 页"><mxCell vertex="1" parent="layer-3" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;"><mxGeometry x="381.24" y="408.976" width="640.44" height="394.845" as="geometry"/></mxCell></UserObject><UserObject id="element-12" label="&lt;div style=&quot;line-height:1.22&quot;&gt;Table 1 · 原论文第 7 页&lt;/div&gt;" name="结果表出处"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=17.28;fontColor=#52616a;fontStyle=0;"><mxGeometry x="381.24" y="825.437" width="640.44" height="34.56" as="geometry"/></mxCell></UserObject><UserObject id="element-13" label="&lt;div style=&quot;line-height:1.22&quot;&gt;可执行抢占风险评&lt;br&gt;测&lt;/div&gt;" name="方法标题"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=34.56;fontColor=#754270;fontStyle=1;"><mxGeometry x="58.32" y="916.157" width="284.04" height="89.28" as="geometry"/></mxCell></UserObject><UserObject id="element-14" label="&lt;div style=&quot;line-height:1.22&quot;&gt;我们构建268个验证案例，&lt;br&gt;经Codex、Claude Code和&lt;br&gt;OpenCode评测17个模&lt;br&gt;型，以轨迹审计DIR、规则&lt;br&gt;评分SPR衡量干扰与成功抢&lt;br&gt;占。&lt;/div&gt;" name="方法说明"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=23.76;fontColor=#202e36;fontStyle=0;"><mxGeometry x="58.32" y="1021.277" width="284.04" height="224.323" as="geometry"/></mxCell></UserObject><UserObject id="element-15" label="" name="Figure 2 · 原论文第 4 页"><mxCell vertex="1" parent="layer-3" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;"><mxGeometry x="381.24" y="921.057" width="640.44" height="296.604" as="geometry"/></mxCell></UserObject><UserObject id="element-16" label="&lt;div style=&quot;line-height:1.22&quot;&gt;Figure 2 · 原论文第 4 页&lt;/div&gt;" name="方法图出处"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=17.28;fontColor=#52616a;fontStyle=0;"><mxGeometry x="381.24" y="1251.36" width="640.44" height="34.56" as="geometry"/></mxCell></UserObject><UserObject id="element-17" label="&lt;div style=&quot;line-height:1.22&quot;&gt;Yuejin Xie; Yu Li; Dadi Guo; Qingyu Liu; Yuqian Fu; Yanwei Fu; Yujiu Yang; Xia Hu; Dongrui Liu&lt;/div&gt;" name="论文出处"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=17.28;fontColor=#4d5e68;fontStyle=0;"><mxGeometry x="58.32" y="1362.24" width="961.2" height="53.28" as="geometry"/></mxCell></UserObject><UserObject id="element-18" label="&lt;div style=&quot;line-height:1.22&quot;&gt;邀请智能体安全研究者对照默认与保护提示条件下的DIR和SPR，讨论如何让智能体在资源冲突中优先上报&lt;br&gt;而非破坏既有任务。&lt;/div&gt;" name="海报附注"><mxCell vertex="1" parent="layer-3" style="text;html=1;whiteSpace=nowrap;spacing=0;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Noto Sans CJK SC, PingFang SC, Microsoft YaHei, Arial, sans-serif;fontSize=20.52;fontColor=#754270;fontStyle=0;"><mxGeometry x="58.32" y="1298.88" width="961.2" height="57.6" as="geometry"/></mxCell></UserObject></root></mxGraphModel></diagram></mxfile>